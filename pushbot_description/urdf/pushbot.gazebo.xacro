<?xml version="1.0"?>
<!--
  Simulation extensions for PushBot (Gazebo Harmonic + ros2_control).

  1. <ros2_control>: which joints ros2_control drives, what can be commanded
     (command interfaces) and what can be read back (state interfaces).
     The hardware plugin here is the Gazebo one; on a real robot you would
     swap only this plugin for a motor driver.
  2. The gz_ros2_control Gazebo plugin: runs the controller_manager inside
     Gazebo and loads pushbot_control/config/pushbot_controllers.yaml.
  3. The LiDAR sensor. Its data reaches ROS through ros_gz_bridge
     (pushbot_gazebo/config/bridge.yaml).

  Everything here is ignored by RViz; robot_state_publisher passes the
  <ros2_control> block on to the controller_manager.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <ros2_control name="PushBotSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <!-- Drive wheels: commanded by velocity (rad/s), report position and velocity -->
    <joint name="left_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-10</param>
        <param name="max">10</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="right_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-10</param>
        <param name="max">10</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <!-- Session 1 home task: add your jaw joints here (position command interface) -->

  </ros2_control>

  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find pushbot_control)/config/pushbot_controllers.yaml</parameters>
    </plugin>
  </gazebo>

  <!-- 2D LiDAR (similar in spirit to an RPLIDAR A1/A2) -->
  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <!-- Without this, Gazebo uses its own scoped frame name and RViz cannot place the scan -->
      <gz_frame_id>lidar_link</gz_frame_id>
      <topic>scan</topic>
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>${-pi}</min_angle>
            <max_angle>${pi}</max_angle>
          </horizontal>
          <vertical>
            <samples>1</samples>
            <resolution>1</resolution>
            <min_angle>0</min_angle>
            <max_angle>0</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.12</min>
          <max>8.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

</robot>
