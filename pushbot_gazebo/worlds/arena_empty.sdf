<?xml version="1.0"?>
<!--
  PDE4430 arena: 8 m x 6 m walled area with a divider, a pillar, a ledge,
  NO BOXES (mapping version) and a green goal zone in the north-east corner.
  Generated by tools/gen_world.py - edit that script rather than this file.
-->
<sdf version="1.9">
  <world name="arena">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Core systems. Sensors (with a render engine) is required for the gpu_lidar. -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.8 0.85 0.9 1</background>
      <grid>false</grid>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material><ambient>0.85 0.85 0.8 1</ambient><diffuse>0.85 0.85 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_north">
      <static>true</static>
      <pose>0 3.075 0.25 0 0 0.0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>8.3 0.15 0.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>8.3 0.15 0.5</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_south">
      <static>true</static>
      <pose>0 -3.075 0.25 0 0 0.0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>8.3 0.15 0.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>8.3 0.15 0.5</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_east">
      <static>true</static>
      <pose>4.075 0 0.25 0 0 0.0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.15 6.0 0.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.15 6.0 0.5</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_west">
      <static>true</static>
      <pose>-4.075 0 0.25 0 0 0.0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.15 6.0 0.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.15 6.0 0.5</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="divider">
      <static>true</static>
      <pose>-0.5 1.75 0.25 0 0 0.0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.15 2.5 0.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.15 2.5 0.5</size></box></geometry>
          <material><ambient>0.55 0.55 0.6 1</ambient><diffuse>0.55 0.55 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="pillar">
      <static>true</static>
      <pose>1.8 -1.0 0.25 0 0 0.0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.4 0.4 0.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.4 0.4 0.5</size></box></geometry>
          <material><ambient>0.55 0.55 0.6 1</ambient><diffuse>0.55 0.55 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="ledge">
      <static>true</static>
      <pose>-2.5 -2.0 0.25 0 0 0.0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.2 0.15 0.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>1.2 0.15 0.5</size></box></geometry>
          <material><ambient>0.55 0.55 0.6 1</ambient><diffuse>0.55 0.55 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Goal zone: a visual-only green square (no collision, so the robot and LiDAR ignore it) -->
    <model name="goal_zone">
      <static>true</static>
      <pose>3.2 2.2 0.001 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>1.2 1.2 0.002</size></box></geometry>
          <material><ambient>0.1 0.7 0.2 1</ambient><diffuse>0.1 0.7 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- No boxes: this version is for mapping with SLAM -->
  </world>
</sdf>
